#!/bin/sh
set -e

HICOLOR_DIR="/usr/share/icons/hicolor"
ICONS="
application-pet.svg
application-x-sfs.svg
application-x-squashfs-image.svg
"
SIZES="
48x48
24x24
scalable
16x16
"

case "${1:-remove}" in
    remove|purge)
        for size in $SIZES; do
            for icon in $ICONS; do
                rm -f "$HICOLOR_DIR/$size/mimetypes/$icon"
            done
        done

        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -f -t "$HICOLOR_DIR" >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
