# ROX-Filer 2.12 GTK3 r5 terminal integration

#: menu.c
msgid "Open Terminal Here"
msgstr "Obre el terminal aquí"

#: menu.c
msgid "Run in Terminal"
msgstr "Executa en un terminal"

#: menu.c
msgid "Select a single folder to open a terminal there."
msgstr "Seleccioneu una sola carpeta per obrir-hi un terminal."

#: menu.c
msgid "Select a single executable file or script to run in a terminal."
msgstr "Seleccioneu un sol fitxer executable o script per executar-lo en un terminal."

#: menu.c
msgid "The selected item is not a folder."
msgstr "L'element seleccionat no és una carpeta."

#: menu.c
msgid "The selected item cannot be run in a terminal."
msgstr "L'element seleccionat no es pot executar en un terminal."

#: menu.c
msgid "The selected AppImage is not executable. Enable its execute permission first."
msgstr "L'AppImage seleccionada no és executable. Activeu primer el permís d'execució."

#: menu.c
msgid "Python 3 was not found. Install python3 or make the script executable with a valid shebang."
msgstr "No s'ha trobat Python 3. Instal·leu python3 o feu que l'script sigui executable amb un shebang vàlid."

#: menu.c
msgid "Failed to parse terminal command '%s':\n%s"
msgstr "No s'ha pogut analitzar l'ordre del terminal '%s':\n%s"

#: menu.c
msgid "Terminal command is empty."
msgstr "L'ordre del terminal és buida."

#: menu.c
msgid "Script completed. Press RETURN to close the terminal."
msgstr "L'script ha finalitzat. Premeu RETURN per tancar el terminal."

#: drives.c
msgid "Partitions"
msgstr "Particions"

#: drives.c
msgid "Show partitions, mount them and open their contents"
msgstr "Mostra les particions, munta-les i obre’n el contingut"

#: drives.c
msgid "No usable partitions found"
msgstr "No s'han trobat particions utilitzables"

#: drives.c
msgid "Mounted"
msgstr "Muntada"

#: drives.c
msgid "Not mounted"
msgstr "No muntada"

#: drives.c
msgid "The lsblk command is required to list partitions."
msgstr "Cal l’ordre lsblk per llistar les particions."

#: drives.c
msgid "Volume %s"
msgstr "Volum %s"

#: drives.c
msgid "The mount command failed."
msgstr "Ha fallat l’ordre de muntatge."

#: drives.c
msgid "Could not mount '%s'."
msgstr "No s'ha pogut muntar «%s»."

#: drives.c
msgid "The partition could not be mounted."
msgstr "No s'ha pogut muntar la partició."

#: drives.c
msgid "The partition '%s' was mounted, but its mount point could not be found."
msgstr "La partició «%s» s'ha muntat, però no se n'ha trobat el punt de muntatge."

